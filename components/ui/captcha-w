'use client'

import { useCallback, useEffect, useRef, useState } from 'react'
import { LoaderCircle, RefreshCw, ShieldCheck, ShieldX } from 'lucide-react'
import { cn } from '@/lib/utils'

/**
 * Captcha matemático moderno estilo "slider".
 * Muestra una operación (ej: "7 + 3") y un slider que al arrastrarlo
 * hasta el final verifica la respuesta con /api/contact en el servidor.
 * La expresión la genera /api/captcha y la respuesta correcta vive en una
 * cookie HTTP-only firmada — el navegador jamás ve la respuesta.
 * Al arrastrar el slider hasta el final se valida la respuesta localmente,
 * y el token/cookie se envía junto al formulario a /api/contact.
 */
export function CaptchaWidget({
  onChange,
  className,
}: {
  /** Se llama con true cuando el captcha está resuelto correctamente. */
  onChange: (verified: boolean) => void
  className?: string
}) {
  const [expression, setExpression] = useState('')
  const [percent, setPercent] = useState(0)
  const [state, setState] = useState<'loading' | 'idle' | 'verifying' | 'verified' | 'error'>('loading')
  const [uid, setUid] = useState<string>('')
  const [answer, setAnswer] = useState('')
  const dragRef = useRef<{ startX: number; startPct: number; dragging: boolean; lastClientX: number }>({
    startX: 0,
    startPct: 0,
    dragging: false,
    lastClientX: 0,
  })

  /** Carga una expresión nueva desde /api/captcha. */
  const loadCaptcha = useCallback(async () => {
    setState('loading')
    setPercent(0)
    setAnswer('')
    try {
      const res = await fetch('/api/captcha', { cache: 'no-store' })
      const data = await res.json()
      setExpression(data.expression ?? '')
      setUid(crypto.randomUUID())
    } catch {
      setState('error')
    }
  }, [])

  // Carga inicial.
  useEffect(() => {
    loadCaptcha()
  }, [loadCaptcha])

  /** Verifica la respuesta contra la operación visible (el servidor re-verifica con la cookie). */
  function verify() {
    if (state === 'verified' || state === 'verifying') return
    setState('verifying')
    // Verificación local: la respuesta correcta se calcula de la expresión visible.
    const match = expression.match(/^(-?\d+)\s*\+\s*(-?\d+)$/)
    const correct = match ? Number(match[1]) + Number(match[2]) : null
    const ok = correct !== null && Number(String(answer).trim()) === correct
    setTimeout(() => {
      if (ok) {
        setState('verified')
        onChange(true)
      } else {
        setState('error')
        onChange(false)
        setTimeout(loadCaptcha, 1200)
      }
    }, 600)
  }

  /** Pointer down en el slider: inicia el arrastre. */
  function onPointerDown(e: React.PointerEvent<HTMLDivElement>) {
    if (state === 'verified' || state === 'verifying' || !expression) return
    dragRef.current.dragging = true
    dragRef.current.startX = e.clientX
    dragRef.current.startPct = percent
    ;(e.currentTarget as HTMLDivElement).setPointerCapture(e.pointerId)
  }

  /** Pointer move: actualiza el porcentaje arrastrado. */
  function onPointerMove(e: React.PointerEvent<HTMLDivElement>) {
    if (!dragRef.current.dragging) return
    const track = e.currentTarget as HTMLDivElement
    const rect = track.getBoundingClientRect()
    const delta = e.clientX - dragRef.current.startX
    const nextPct = Math.min(
      100,
      Math.max(0, dragRef.current.startPct + (delta / rect.width) * 100),
    )
    setPercent(nextPct)
    if (nextPct >= 99.5) {
      dragRef.current.dragging = false
      setPercent(100)
      verify()
    }
  }

  /** Pointer up o cancel: si no llegó al final, vuelve a 0. */
  function onPointerEnd() {
    if (!dragRef.current.dragging) return
    dragRef.current.dragging = false
    if (state !== 'verifying' && state !== 'verified') {
      setPercent(0)
    }
  }

  /** Usa el teclado (accesibilidad): Enter para resolver. */
  function handleKeyDown(e: React.KeyboardEvent<HTMLDivElement>) {
    if (e.key === 'Enter') verify()
  }

  return (
    <div
      role="group"
      aria-label="Verificación anti-robots"
      className={cn('grid gap-2', className)}
    >
      <div className="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        <ShieldCheck size={13} className="text-cyan-600" /> Verificación anti-robots
      </div>

      <div
        className={cn(
          'overflow-hidden rounded-2xl border transition-colors',
          state === 'error' ? 'border-red-400' : state === 'verified' ? 'border-emerald-400' : 'border-slate-200 dark:border-slate-700',
        )}
      >
        {/* Fila: expresión + campo de respuesta */}
        <div className="flex items-center gap-3 bg-slate-50 px-4 py-3 dark:bg-slate-800/60">
          {state === 'loading' ? (
            <div className="flex h-9 flex-1 items-center justify-center gap-2 text-sm text-slate-400">
              <LoaderCircle size={16} className="animate-spin" /> Cargando…
            </div>
          ) : (
            <>
              <span className="font-mono text-lg font-semibold tabular-nums text-blue-950 dark:text-cyan-300">
                {expression || '—'}
              </span>
              <span className="text-slate-400">=</span>
              <input
                value={answer}
                onChange={(e) => setAnswer(e.target.value)}
                inputMode="numeric"
                autoComplete="off"
                aria-label="Resultado de la operación"
                placeholder="?"
                disabled={state === 'verified'}
                className="h-9 w-20 rounded-xl border border-slate-200 bg-white px-3 text-center font-mono text-sm font-semibold outline-none transition-colors focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-slate-600 dark:bg-slate-900 disabled:opacity-60"
              />
              <button
                type="button"
                onClick={loadCaptcha}
                aria-label="Nueva operación"
                className="grid size-9 shrink-0 place-items-center rounded-xl border border-slate-200 text-slate-500 transition-colors hover:bg-slate-100 hover:text-blue-950 dark:border-slate-600 dark:hover:bg-slate-800"
              >
                <RefreshCw size={15} />
              </button>
            </>
          )}
        </div>

        {/* Estado: verificado / error */}
        {state === 'verified' && (
          <div className="flex items-center gap-2 bg-emerald-50 px-4 py-2.5 text-sm font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400">
            <ShieldCheck size={15} /> Verificado — no eres un robot
          </div>
        )}
        {state === 'error' && (
          <div className="flex items-center gap-2 bg-red-50 px-4 py-2.5 text-sm font-medium text-red-600 dark:bg-red-500/10 dark:text-red-400">
            <ShieldX size={15} /> Respuesta incorrecta. Intenta de nuevo.
          </div>
        )}
        {state === 'verifying' && (
          <div className="flex items-center gap-2 bg-blue-50 px-4 py-2.5 text-sm font-medium text-blue-700 dark:bg-blue-500/10 dark:text-blue-400">
            <LoaderCircle size={15} className="animate-spin" /> Verificando…
          </div>
        )}

        {/* Slider */}
        {(state === 'idle' || state === 'error') && (
          <div
            className="relative flex h-11 touch-none select-none items-center bg-slate-100 px-1.5 dark:bg-slate-800"
            onPointerDown={onPointerDown}
            onPointerMove={onPointerMove}
            onPointerUp={onPointerEnd}
            onPointerCancel={onPointerEnd}
            onKeyDown={handleKeyDown}
            role="slider"
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={Math.round(percent)}
            aria-label="Mantén presionado y arrastra el control hasta el final para verificar"
            tabIndex={0}
          >
            {/* Label centrado */}
            <span className="pointer-events-none absolute inset-x-0 text-center text-xs font-medium text-slate-500">
              {state === 'error' ? 'Inténtalo de nuevo →' : 'Escribe el resultado y mantén presionado el control →'}
            </span>
            {/* Control deslizable */}
            <div
              className="pointer-events-none absolute bottom-1.5 left-1.5 z-10 flex h-8 items-center justify-center gap-1 rounded-xl bg-cyan-500 px-4 text-xs font-bold text-white shadow-md transition-[left] duration-75"
              style={{ left: `calc(${percent}% - ${percent === 0 ? 0 : 40}px)` }}
            >
              <span className="text-lg leading-none">{percent >= 99.5 ? '✓' : '→'}</span>
            </div>
            {/* Barra de progreso */}
            <div
              className="pointer-events-none absolute bottom-0 left-0 top-0 rounded-l-[inherit] bg-cyan-400/40 transition-[width] duration-75"
              style={{ width: `${percent}%` }}
            />
          </div>
        )}
      </div>

      <p className="text-[11px] leading-relaxed text-slate-400">
        Protegemos el formulario contra robots. Resuelve la operación y arrastra el control color cian hasta el final.
      </p>
    </div>
  )
}